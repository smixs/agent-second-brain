# ── обязательное ─────────────────────────────────────────────────────
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Deepgram для расшифровки голосовых
DEEPGRAM_API_KEY=

# Твой Telegram user ID (узнать: @userinfobot).
# ПЕРВЫЙ id получает алерты о здоровье и ежедневный отчёт.
# Пустой список = бота не может использовать никто.
ALLOWED_USER_IDS=[123456789]

# ── основное ─────────────────────────────────────────────────────────
# Путь к Obsidian vault
VAULT_PATH=./vault

# Часовой пояс для таймеров и отчётов
TZ=Asia/Almaty

# Модель постоянной сессии. Пусто = дефолт Claude Code.
# "sonnet" заметно снижает расход недельного лимита при работе 24/7.
CLAUDE_MODEL=

# ── планировщик ──────────────────────────────────────────────────────
# Задания агент заводит себе сам через скилл cron.
CRON_ENABLED=true

# ── продвинутое (дефолты рабочие — трогать только осознанно) ─────────
# Каталог состояния: локи, pane.log, rate_limit.json. Только ЛОКАЛЬНАЯ ФС.
#RUNTIME_DIR=~/.dbrain
# Имя tmux-сессии (пусто = сгенерируется и запомнится при установке)
#BRAIN_SESSION_NAME=
# Пустить в бота ВСЕХ — дыра в безопасности, оставь false
#ALLOW_ALL_USERS=false

# Watchdog живёт внутри процесса бота. Отдельный процесс больше не нужен.
#WATCHDOG_ENABLED=true
#WATCHDOG_TICK_SECONDS=15

# Отдельная Claude-сессия под cron: +1 постоянный процесс Claude Code
# (сотни МБ). По умолчанию задания идут в основную сессию как maint-ходы.
#CRON_ISOLATED_SESSION=false
# Тюнинг cron: интервал тикера / таймаут задания / число ошибок подряд
# до авто-отключения / задержка ретрая разового задания
#CRON_TICK_SECONDS=60
#CRON_JOB_TIMEOUT=600
#CRON_MAX_CONSECUTIVE_ERRORS=3
#CRON_RETRY_SECONDS=300
