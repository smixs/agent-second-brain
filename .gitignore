.DS_Store
Thumbs.db

# Vault personal data (never commit these)
vault/daily/
vault/contacts/
vault/finances/
vault/attachments/
vault/.session/
vault/.graph/
vault/business/
vault/projects/
vault/thoughts/

# Local agent-skill installs (npx/pnpm skills add) — dev tooling, not the
# product. Anchored to the repo root: vault/.claude/ IS the product.
/.agents/
/.claude/
/skills-lock.json

# Obsidian UI state — меняется от каждого клика, в git не нужен
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json

# Runtime state
vault/.sessions/

# Плагины Obsidian — бандлы по сотне-другой КБ, ставятся из самого Obsidian
vault/.obsidian/plugins/
